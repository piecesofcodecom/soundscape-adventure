<div class="soundscape-wrapper">
    <div class="soundboardadv">

        <header class="header" role="banner">
            <h1 class="logo">
                <a>{{name}}<br /><span>Moods</span></a>
            </h1>

            <div class="main-nav">
                <ul class="unstyled list-hover-slide">
                    {{#each moods}}
                    <li class="flexrow mood-wrapper" style="gap: 0.5rem; padding-left: 5px;"
                        data-mood-id="{{ this.id }}" data-soundscape-id="{{ ../soundscapeId}}">
                        <!-- Play button aligned left -->
                        {{#if (eq this.status  2)}}
                        <a data-action="playStopMood" class="mood-action flex0" data-tooltip="PLAYLIST.SoundStop"><i
                                class="fa fa-stop item-active"></i></a>
                        {{else}}
                        <a data-action="playStopMood" class="mood-action flex0" data-tooltip="PLAYLIST.SoundPlay"><i
                                class="fa fa-play"></i></a>
                        {{/if}}

                        <!-- Mood name with more width -->
                        <a data-action="viewMood"
                            class="mood-action flex3 {{#if (eq this.id ../activeMood)}} active {{/if}}"
                            style="font-weight: bold;">{{ this.name}}</a>

                        <!-- Right-aligned icons, side-by-side -->
                        <span class="ml-auto flexrow" style="justify-content: flex-end; ">

                            <a data-action="deleteMood" class="mood-action" data-mood-id="{{ this.id }}"
                                data-tooltip="Delete Mood"><i class="fa fa-trash"></i></a>
                            <a data-action="configMood" class="mood-action" data-mood-id="{{ this.id }}"
                                data-tooltip="Configure Mood"><i class="fa fa-gear "></i></a>
                            <a data-action="saveMood" class="mood-action" data-mood-id="{{ this.id }}"
                                data-tooltip="Save Changes"><i class="fa-solid fa-download" {{#if
                                    this.has_changes}}style="color: red" {{/if}} data-mood-id="{{ this.id }}"></i></a>
                        </span>
                    </li>
                    {{/each}}
                </ul>
                <div class="mood-action-buttons" style="display: grid; padding: 1em; gap: 0.5em;">
                    <button class="mood-action" data-type="mood" data-action="createMood">
                        <i class="fas fa-plus"></i> New Mood</button>

                    <button class="mood-action" data-type="mood" data-action="cloneMood">
                        <i class="fas fa-copy"></i> Clone Mood</button>
                </div>
            </div>

        </header>
        {{#each moods}}
        <div class="soundboardadv-main {{#if (eq this.id ../activeMood)}} mood-active {{/if}}"
            data-mood-id="{{ this.id }}" data-soundscape-id="{{ @root/soundscapeId}}">
            {{#each this.sounds }}
            {{#if (ne this.type 3)}}
            <div class="sound-group-type {{this.name}}" data-sound-type="{{ this.type }}">
                <div class="flexrow">
                    <div class="flexrow">
                        <h2 style=" padding-left: 6px; margin-top: 0.5em;">{{this.name }} Sounds
                            

                        </h2>
                        {{#if (ne this.type 7) }}
                            <i class="fa-regular fa-folder-medical new-category" style="
        font-size: x-large;
        padding: 2px;
        text-align: right; cursor: pointer; margin-right: 10px;" data-tooltip="Create a new category"></i>
                            {{/if}}
                    </div>

                </div>

                {{#each this.categories}}
                <div id="{{ ../this.name }}-{{this.name}} drop-zone" data-drop-zone-type="{{ this.type }}"
                                data-drop-zone-category="{{this.id}}" style="margin-left: 0.5em; margin-right: 0.5em;">
                    <div class="sound-category grid flexcol"
                         {{#if (ne ../this.type 7)}}style="border: 1px solid rgba(0,0,0,0.2); padding-bottom: 0.7em;"{{/if}}>
                        {{#if (ne ../this.type 7)}}
                        <div class="grid grid-4col" style="background-color: rgba(0,0,0,0.2); ">
                            <div class="grid">
                            <h4 class="category-title" style="color: #000; flex: 2"  data-category-id="{{this.id}}" data-category-type="{{this.type}}">
                                <i class="fa fa-angle-{{#if this.collapsed}}up{{else}}down{{/if}}"></i>&nbsp;Category:{{this.name}}
                            </h4>
                            </div>
                            <div class="grid" style="grid-template-columns: auto;">
                            <span class="flexrow"
                                style="align-items: center; text-align: center; color: black; font-size: medium; justify-content: flex-end; margin-right: 10px;     flex: 2;">
                                {{#unless (eq this.name "None") }}
                                <i class="fa-solid fa-trash category-control" style="max-width: 40px"
                                    data-category-id="{{this.id}}" data-mood-id="{{../../id}}" data-action="delete"
                                    data-tooltip="Delete the category {{this.name}} and move sounds to the Category None"></i>
                                {{/unless}}
                                &nbsp;<i class="fa-solid fa-music category-control" style="max-width: 40px"
                                    data-category-id="{{this.id}}" data-mood-id="{{../../id}}" data-action="enableAll"
                                    data-tooltip="Enable all sounds in the category {{this.name}}"></i>
                                &nbsp;<i class="fa fa-play category-control" style="max-width: 40px"
                                    data-category-id="{{this.id}}" data-mood-id="{{../../id}}" data-action="play"
                                    data-tooltip="Start all enabled sounds in the category {{this.name}}"></i>
                                &nbsp;<i class="fa fa-stop category-control" style="max-width: 40px"
                                    data-category-id="{{this.id}}" data-mood-id="{{../../id}}" data-action="stop"
                                    data-tooltip="Stop all enabled sounds in the category {{this.name}}"></i>
                            </span>
                            </div>

                        </div>
                        {{/if}}
                        {{#if (eq ../this.type 7)}}
                        {{!-- List view for Category None Soundpad sounds --}}
                        <div class="soundpad-list-container drop-zone" data-drop-zone-type="{{ ../this.type }}" {{#if
                            this.collapsed}} style="display: none" {{/if}} data-drop-zone-category="{{this.id}}">

                            {{#each this.sounds}}
                            <div class="soundpad-list-item data-drag" data-sound-id="{{ this.id }}"
                                data-mood-id="{{ ../../../id }}" data-tooltip="{{this.name}}">

                                <div class="soundpad-list-content">
                                    {{!-- Sound Name --}}
                                    <div class="soundpad-sound-name">
                                        <span data-full-name="{{this.name}}">{{this.name}}</span>
                                    </div>

                                    {{!-- Volume Slider --}}
                                    <div class="soundpad-volume-section">
                                        <div class="soundpad-volume-container" draggable="false">
                                            <span class="volume-label">Vol:</span>
                                            <input type="range" min="0" max="1" step="0.05"
                                                class="soundpad-volume-slider sound-control" value="{{this.volume }}"
                                                data-sound-id="{{ this.id }}" data-mood-id="{{../../../id}}"
                                                data-action="volume" draggable="false" />
                                            <span class="volume-value" id="volume-value-{{this.id}}">{{volumeUI
                                                this.volume}}</span>
                                        </div>
                                    </div>

                                    {{!-- Action Buttons --}}
                                    <div class="soundpad-actions">
                                        <button class="library-btn sound-control" data-tooltip="Configuration"
                                            data-action="edit-sound" data-mood-id="{{ ../../../id }}"
                                            data-sound-id="{{ this.id }}" data-group="{{ this.group }}">
                                            <i class="fas fa-cog"></i>
                                        </button>

                                        <button class="library-btn sound-control" data-tooltip="Play sound"
                                            data-action="play" data-mood-id="{{ ../../../id }}"
                                            data-sound-id="{{ this.id }}" data-group="{{ this.group }}">
                                            <i class="fas fa-play"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            {{/each}}
                        </div>
                        {{else}}
                        {{!-- Keep the original card view for other categories --}}
                        <div class="soundscapeadv-container drop-zone" data-drop-zone-type="{{ ../this.type }}" {{#if
                            this.collapsed}} style="display: none" {{/if}} data-drop-zone-category="{{this.id}}">
                            {{#ifEmptyArray this.sounds}}
                            <span> Drop sounds here</span>
                            {{/ifEmptyArray}}
                            {{#each this.sounds}}
                            <div class="soundscape-sound-card {{#unless (eq this.group "")}}group{{/unless}} data-drag"
                                data-sound-id="{{ this.id }}" data-mood-id="{{ ../../../id }}">
                                <div class="soundscape-sound-top-row">
                                    <!--div class="soundscape-sound-settings-icon"-->
                                    {{!-- <button class="sound-control" data-tooltip="Configuration"
                                        data-action="edit-sound" data-mood-id="{{ ../../../id }}"
                                        data-sound-id="{{ this.id }}" data-group="{{ this.group }}"> --}}
                                        <div style="display: flex; gap: 0.5rem;">
                                            <i class="fas fa-cog sound-control sound-control-icon"
                                                data-tooltip="Configuration" data-action="edit-sound"
                                                data-mood-id="{{ ../../../id }}" data-sound-id="{{ this.id }}"
                                                data-group="{{ this.group }}"></i>

                                            {{!-- <i class="fas fa-ear sound-control sound-control-icon"
                                                data-tooltip="Preview" data-action="preview-sound"
                                                data-mood-id="{{ ../../../id }}" data-sound-id="{{ this.id }}"
                                                data-group="{{ this.group }}"></i> --}}
                                        </div>
                                        {{!--
                                    </button> --}}
                                    <!--/div-->
                                    {{#unless (eq ../../type 3)}}
                                    <label class="soundscape-sound-switch">
                                        <input class="sound-control" type="checkbox" data-action="enableDisableAudio"
                                            data-sound-id="{{ this.id }}" data-mood-id="{{ ../../../id }}" {{#if (eq
                                            this.status "on" )}}checked{{/if}}>
                                        <span class="soundscape-sound-slider-switch round"></span>
                                    </label>
                                    {{else}}
                                    <div class="soundscape-sound-settings-icon">
                                        <button class="sound-control" data-tooltip="Play sound" data-action="play"
                                            data-mood-id="{{ ../../../id }}" data-sound-id="{{ this.id }}"
                                            data-group="{{ this.group }}">
                                            <i class="fas fa-play"></i>
                                        </button>
                                    </div>
                                    {{/unless}}
                                </div>
                                <div class="soundscape-sound-title" data-full-name="{{this.name}}">{{this.name}}</div>

                                {{!-- REPLACE the entire intensity + volume section with this compact version: --}}

                                {{#if (eq this.type 4)}}
                                <div class="compact-intensity-control">
                                    <i class="fas fa-chart-line intensity-icon" data-tooltip="Intensity"></i>
                                    <input type="range" class="compact-intensity-slider sound-control" min="0" max="100"
                                        step="5" value="{{this.intensity }}" data-mood-id="{{../../../id}}"
                                        data-sound-id="{{ this.id }}" data-action="intensity"
                                        data-group="{{ this.group }}" />
                                    <span class="compact-intensity-value"
                                        id="compact-intensity-{{this.id}}">{{this.intensity}}%</span>
                                </div>
                                {{/if}}

                                <div class="compact-volume-control" draggable="false">
                                    <i class="fas {{volumeIcon this.volume}} volume-icon" data-tooltip="Volume"></i>
                                    <input type="range" min="0" max="1" step="0.05"
                                        class="compact-volume-slider sound-control" value="{{this.volume }}"
                                        data-sound-id="{{ this.id }}" data-mood-id="{{../../../id}}"
                                        data-action="volume" draggable="false" />
                                    <span class="compact-volume-value volume-value"
                                        id="compact-volume-{{this.id}}">{{volumeUI this.volume}}</span>
                                </div>
                            </div>
                            {{/each}}
                        </div>
                        {{/if}}
                    </div>
                </div>
                {{/each}}
            </div>
            {{else}}


            {{/if}}
            {{/each }}
        </div>
        {{/each}}
    </div>

    <div class="soundscape-sliding-panel {{#if libraryIsOpen}}open{{/if}} slide-active"
        style="{{#if (not activeMood)}} display: none; {{/if}}">
        <div class="soundscape-sliding-ear">{{#if libraryIsOpen}}❮{{else}}❯{{/if}}</div>
        <div class="soundscape-sliding-panel-content">
            
            {{!-- <div class="flexrow dropzone-area drop-zone" data-drop-zone-type="3" data-drop-zone-category="" style="    border: 2px dashed #ffffff;
    align-items: center;
    justify-content: center;
    background-color: rgb(0 0 0 / 20%);
    margin-right: 10px;
    position: absolute;
    float: right;
    width: 150px;
        margin-left: 130px; font-size: smaller;  margin-top: -5px;">
                    <div class="file-upload-icon" style="text-align: center;">
                        <i class="fa-solid fa-file-arrow-down"></i>
                    </div>
                    <p style="flex: 3">Drop sounds to the library here</p>
                </div> --}}
                <h2 class="">Sound Library</h2>
                <input type="text" class="filterInput" placeholder="Search sound by name..." class="form-control" />
                
                
            

            <div class="soundpad-list-container-library flexcol drop-zone" data-drop-zone-type="3"
                data-drop-zone-category="">
                {{#each library}}
                <div class="library-sound-item flexrow data-drag" data-sound-id="{{this.id}}"
                    data-mood-id="{{@root/activeMood}}" data-tooltip="">

                    <div class="flexrow">
                        {{!-- Sound Name --}}
                        <div class="" style="flex: 4;">
                            <span class="library-sound-name" data-full-name="{{this.name}}">{{this.name}}</span>
                        </div>

                        {{!-- Volume Slider
                        <div class="soundpad-volume-section">
                            <div class="soundpad-volume-container" draggable="false">
                                <span class="volume-label">Vol:</span>
                                <input type="range" min="0" max="1" step="0.05"
                                    class="soundpad-volume-slider sound-control" value="asd" data-sound-id="asd"
                                    data-mood-id="asd" data-action="volume" draggable="false" />
                                <span class="volume-value" id="volume-value-12">12</span>
                            </div>
                        </div> --}}

                        {{!-- Action Buttons --}}
                        <div class="soundpad-actions" style="align-items: center;justify-content: end;">
                            {{!-- <button class="soundpad-btn sound-control" data-tooltip="Configuration"
                                data-action="edit-sound" data-mood-id="asd" data-sound-id="asd" data-group="ad">
                                <i class="fas fa-cog"></i>
                            </button> --}}
                            <button class="soundpad-btn sound-control" data-tooltip="Preview"
                                data-action="preview-sound" data-mood-id="{{ ../activeMood }}"
                                data-sound-id="{{ this.id }}" data-group="{{ this.group }}">
                                <i class="fas fa-play sound-control-icon"></i>
                            </button>
                            {{!-- <button class="soundpad-btn sound-control" data-tooltip="Play sound"
                                data-action="preview" data-mood-id="dasd" data-sound-id="asd" data-group="dasd">
                                <i class="fas fa-play"></i>
                            </button> --}}
                        </div>
                    </div>

                </div>
                {{/each}}

            </div>
        </div>
    </div>

</div>
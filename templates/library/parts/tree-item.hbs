{{!-- One folder-tree row. Rendered per-row by LibraryApp's windowing (#renderTreeWindow). --}}
{{#if isDir}}
{{#if ignored}}
<div class="sa-lib-tree__dir is-ignored" style="padding-left:{{indent}}px" data-path="{{path}}">
    <i class="fas fa-ban sa-lib-tree__chevron"></i>
    <i class="fas fa-folder"></i>
    <span class="sa-lib-tree__name">{{name}}</span>
    <span class="sa-lib-tree__ignored-label">ignored</span>
    <button type="button" class="sa-lib-tree__restore" data-action="restore-folder" data-path="{{path}}"
        data-tooltip="Stop ignoring this folder"><i class="fas fa-rotate-left"></i></button>
</div>
{{else}}
<div class="sa-lib-tree__dir" style="padding-left:{{indent}}px" data-action="toggle-dir" data-path="{{path}}">
    <i class="fas {{#if collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}} sa-lib-tree__chevron"></i>
    <i class="fas fa-folder"></i>
    <span class="sa-lib-tree__name">{{name}}</span>
    <span class="sa-lib-tree__count">{{count}}</span>
    <button type="button" class="sa-lib-tree__folder-pl" data-action="folder-to-playlist" data-path="{{path}}"
        data-tooltip="Add folder to playlist"><i class="fas fa-list-music"></i></button>
    <button type="button" class="sa-lib-tree__folder-remove" data-action="remove-folder" data-path="{{path}}"
        data-tooltip="Remove folder"><i class="fas fa-trash"></i></button>
</div>
{{/if}}
{{else}}
{{#if ignored}}
<div class="sa-lib-tree__file is-ignored" style="padding-left:{{indent}}px" data-path="{{path}}">
    <i class="fas fa-ban"></i>
    <span class="sa-lib-tree__name">{{name}}</span>
    <span class="sa-lib-tree__ignored-label">ignored</span>
    <button type="button" class="sa-lib-tree__restore" data-action="restore-file" data-full="{{fullPath}}"
        data-tooltip="Stop ignoring this file"><i class="fas fa-rotate-left"></i></button>
</div>
{{else}}
<div class="sa-lib-tree__file {{#if missing}}is-missing{{/if}}" style="padding-left:{{indent}}px" data-id="{{id}}" data-path="{{path}}" draggable="true">
    <button type="button" class="sa-lib-item__play" data-action="preview" data-tooltip="Preview">
        <i class="fas fa-play"></i>
    </button>
    <button type="button" class="sa-lib-star {{#if favorite}}is-on{{/if}}" data-action="favorite"
        data-tooltip="Favorite">
        <i class="fas fa-star"></i>
    </button>
    <span class="sa-lib-tree__name">{{name}}</span>
    {{#if missing}}
    <span class="sa-lib-badge sa-lib-badge--{{missingReason}}">{{missingReason}}</span>
    {{/if}}
    <span class="sa-lib-duration">{{duration}}</span>
    <button type="button" class="sa-lib-item__pl" data-action="add-to-playlist" data-tooltip="Add to playlist">
        <i class="fas fa-list-music"></i>
    </button>
    <button type="button" class="sa-lib-item__copy" data-action="copy-path" data-tooltip="Copy path">
        <i class="fas fa-copy"></i>
    </button>
    <button type="button" class="sa-lib-item__remove" data-action="remove" data-tooltip="Remove from library">
        <i class="fas fa-trash"></i>
    </button>
</div>
{{/if}}
{{/if}}

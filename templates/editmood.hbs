<div class="sound-editor">
    <!-- Identity -->
    <section class="editor-section">
        <h2>Identity</h2>
        <div class="identity-grid">
            
            <div class="field">
                <label>Mood Name</label>
                <input type="text" id="moodName" name="moodName" value="{{ mood.name }}">
            </div>
        </div>
    </section>


    <!-- Triggers -->
    <section class="editor-section">
        <h2>Triggers</h2>

        <div class="trigger-list">
            <!-- Trigger Card -->
            {{#each triggers}}
            <div class="trigger-card">
                <header>
                    <span>Trigger {{ @index }}</span>
                    {{!-- <button class="remove">✕</button> --}}
                </header>

                <div class="field">
                    <label for="triggerAction{{ @index }}">Action</label>
                    <select id="triggerAction{{ @index }}" name="triggerAction">
                        <option>Select</option>
                        {{#each this.actions}}
                        <option value="{{ this.id }}" {{#if this.selected }}selected {{/if}}>{{ this.name }}</option>
                        {{/each}}
                    </select>
                </div>

                <div class="field">
                    <label for="triggerOn{{ @index }}">On</label>
                    <select id="triggerOn{{ @index }}" name="triggerOn">
                        <option>Select</option>
                        {{#each this.on}}
                        <option value="{{ this.id }}" {{#if this.selected }}selected {{/if}}>{{ this.name }}</option>
                        {{/each}}
                    </select>
                </div>

                <div class="field">
                    <label for="triggerEvent{{ @index }}">Event</label>
                    <select id="triggerEvent{{ @index }}" name="triggerEvent">
                        <option>Select</option>
                        {{#each this.events}}
                        <option value="{{ this.id }}" {{#if this.selected }}selected {{/if}}>{{ this.name }}</option>
                        {{/each}}
                    </select>
                </div>
            </div>
            {{/each}}
            <!-- Add Trigger -->
            {{!-- <button class="add-trigger">➕ Add Trigger</button> --}}
        </div>
        <div style="width: 100%; text-align: center;
    align-items: center;
    display: flex;
    justify-content: center;
    padding-top: 1em;">
            <button class="removeAllTriggers" data-mood-id="{{ mood.id }}">
                <i class="fa-solid fa-broom"></i>Remove all triggers for this mood
            </button>
        </div>

    </section>

</div>
<!-- LEFT: Mood List -->
<aside class="sa-moods">
    <header class="sa-panel-header">
        <h2>Moods</h2>
        <span class="sa-count">{{length moods}}</span>
    </header>

    <ul class="sa-mood-list">
        {{#each moods as |mood| }}
        <li class="sa-mood {{#if mood.is_selected}}active{{/if}} {{#isMoodPlaying mood.status}}is-playing{{/isMoodPlaying}} mood-action" data-mood-id="{{ mood.id }}"
            data-action="viewMood" data-soundscape-id="{{ @root.soundscapeId}}">
            <span class="name">
                {{#isMoodPlaying mood.status}}<span class="sa-mood-eq" aria-hidden="true"><i></i><i></i><i></i></span>{{/isMoodPlaying}}
                <a class="mood-name">{{mood.name}}</a>
            </span>
            <div class="sa-mood-actions">
                {{#if mood.has_changes}}
                <a data-action="saveMood" class="mood-action" data-mood-id="{{ mood.id }}" data-tooltip="SAADV.MOOD.Save">
                    <i class="fa-solid fa-download sa-unsaved" data-mood-id="{{ mood.id }}"></i>
                </a>
                {{/if}}
                {{#isMoodPlaying mood.status}}
                <a data-action="playStopMood" class="mood-action" data-tooltip="SAADV.MOOD.Stop">
                    <i class="fas fa-stop"></i>
                </a>
                {{else}}
                <a data-action="playStopMood" class="mood-action" data-tooltip="SAADV.MOOD.Play">
                    <i class="fas fa-play"></i>
                </a>
                {{/isMoodPlaying}}
                <a data-action="configMood" class="mood-action" data-mood-id="{{ mood.id }}"
                    data-tooltip="SAADV.MOOD.Configure">
                    <i class="fas fa-cog"></i>
                </a>
                <a data-action="deleteMood" class="mood-action" data-mood-id="{{ mood.id }}"
                    data-tooltip="SAADV.MOOD.Delete">
                    <i class="fa fa-trash"></i>
                </a>
            </div>
        </li>
        {{/each}}
    </ul>

    <footer class="sa-footer-menu" data-soundscape-id="{{ @root.soundscapeId}}">
        <button class="sa-btn mood-action" data-type="mood" data-action="createMood" data-tooltip="SAADV.MOOD.New">
            <i class="fas fa-plus"></i>
        </button>
        <button class="sa-btn secondary mood-action" data-type="mood" data-action="cloneMood" data-tooltip="SAADV.MOOD.Clone">
            <i class="fa fa-copy"></i>
        </button>
        <button class="sa-btn secondary mood-action" data-type="mood" data-action="openLibrary"
            data-tooltip="Open the Sound Library">
            <i class="fa fa-list-music"></i>
        </button>
    </footer>
    {{#if hasCredits}}
    <section class="credits">
        <h3>Credits</h3>
        {{#each credits as |credit|}}
        <div class="credit-item">
            <h4>{{credit.type}}</h4>
            <p><a href="{{credit.url}}" target="_blank">{{credit.name}}</a></p>
            <p>{{credit.description}}</p>
        </div>
        {{/each}}
    </section>
    {{/if}}
</aside>
<div class="sound-editor">
    <!-- Identity -->
    <section class="editor-section">
        <h2>Identity</h2>
        <div class="identity-grid{{#if (or (eq sound.type 4) (eq sound.type 5))}}-group{{/if}}">
            {{#if (or (eq sound.type 4) (eq sound.type 5))}}
            <div class="group-names">
                {{#each sounds}}
                <a class="sound-remove-group" data-sound-id="{{this.id}}" data-group-id="{{@root.sound.id}}"
                    data-tooltip="Remove from the group">
                    <span class="sound-group-name">{{this.name}}
                        <i style="font-size: smaller;" class="fa-solid fa-xmark">
                        </i></a>
                </span>
                {{/each}}
            </div>
            {{else}}
            <div class="field">
                <label>Sound Name</label>
                <input type="text" id="soundName" name="soundName" value="{{ sound.name }}">
            </div>

            <div class="field">
                <label>Sound Group</label>
                <select name="group" id="group-id" data-sound-id="{{ sound.id }}" data-sound-name="{{ sound.name }}"
                    data-sound-type="{{ sound.type }}" class="sound-add-group">
                    <option>-- Please choose an option --</option>
                    {{#each groups as |group|}}
                    <option value="{{ group.id }}">{{ group.name }}</option>
                    {{/each}}
                    <option value="NewGroup">Create a New Group</option>
                </select>
            </div>
            {{/if}}
            <div class="field icon-field">
                <label>Icon</label>
                <input type="text" id="soundIcon" name="soundIcon" placeholder="Select an icon"
                    value="{{ sound.soundIcon }}" data-dtype="String" style="display: none" />
                <button type="button" class="file-picker sound-icon-button" data-type="image" data-target="input[name='soundIcon']"
                    tabindex="-1" title="Browse Files">
                    {{#ifNotEquals sound.soundIcon ''}}
                    <img class="sound-icon" style="width: 32px; height: 32px;" src="{{sound.soundIcon}}" />
                    {{else}}
                    {{#if (or (eq sound.type 4) (eq sound.type 5))}}
                    <i class="fas fa-speakers" data-tooltip="Group Sound"></i>
                    {{else}}
                    <i class="fas fa-speaker" data-tooltip="Single Sound"></i>
                    {{/if}}
                    {{/ifNotEquals}}
                </button>
            </div>
        </div>
    </section>

    <section class="editor-section">
        <h2>Timing</h2>

        <div class="timing-grid">
            <div class="field">
                <label>Fade In (seconds)</label>
                <div class="range-field fadeIn">
                    <input type="range" min="0" max="60" step="1" class="fadeIn-range" id="fadeIn" name="fadeIn"
                        value="{{ sound.fadeIn }}">
                    <span class="value fadeIn-value">{{ sound.fadeIn }}s</span>
                </div>
            </div>

            <div class="field">
                <label>Fade Out (seconds)</label>
                <div class="range-field fadeOut">
                    <input type="range" min="0" max="60" step="1" class="fadeOut-range" id="fadeOut" name="fadeOut"
                        value="{{ sound.fadeOut }}">
                    <span class="value fadeOut-value">{{ sound.fadeOut }}s</span>
                </div>
            </div>
        </div>

        <!-- Random Playback -->
        {{#if (or (eq sound.type 2) (eq sound.type 5))}}
        <div class="random-block">
            <label class="checkbox">
                <input type="checkbox" id="playOnce" name="playOnce" {{#if sound.playOnce }} checked {{/if}}>
                Play once
            </label>

            <div class="random-interval">
                <div class="field">
                    <label>Interval From (seconds)</label>
                    {{#if (eq sound.type 5)}}
                    <input type="number" id="from" name="from" min="0" value="{{sound.random.from}}">
                    {{else}}
                    <input type="number" id="from" name="from" min="0" value="{{sound.from}}">
                    {{/if}}
                </div>

                <div class="field">
                    <label>Interval To (seconds)</label>
                    {{#if (eq sound.type 5)}}
                    <input type="number" id="to" name="to" min="0" value="{{sound.random.to}}">
                    {{else}}
                    <input type="number" id="to" name="to" min="0" value="{{sound.to}}">
                    {{/if}}
                </div>
            </div>
        </div>
        {{/if}}
    </section>


    <!-- Triggers -->
    <section class="editor-section">
        <h2>Triggers</h2>

        <div class="trigger-list">
            <!-- Trigger Card -->
            {{#each triggers}}
            <div class="trigger-card">
                <header>
                    <span>Trigger {{ @index }}</span>
                    <button class="remove">✕</button>
                </header>

                <div class="field">
                    <label for="triggerAction{{ @index }}">Action</label>
                    <select id="triggerAction{{ @index }}" name="triggerAction">
                        <option>Select</option>
                        {{#each this.actions}}
                        <option value="{{ this.id }}" {{#if this.selected }}selected {{/if}}>{{ this.name }}</option>
                        {{/each}}
                    </select>
                </div>

                <div class="field">
                    <label for="triggerOn{{ @index }}">On</label>
                    <select id="triggerOn{{ @index }}" name="triggerOn">
                        <option>Select</option>
                        {{#each this.on}}
                        <option value="{{ this.id }}" {{#if this.selected }}selected {{/if}}>{{ this.name }}</option>
                        {{/each}}
                    </select>
                </div>

                <div class="field">
                    <label for="triggerEvent{{ @index }}">Event</label>
                    <select id="triggerEvent{{ @index }}" name="triggerEvent">
                        <option>Select</option>
                        {{#each this.events}}
                        <option value="{{ this.id }}" {{#if this.selected }}selected {{/if}}>{{ this.name }}</option>
                        {{/each}}
                    </select>
                </div>
            </div>
            {{/each}}
            <!-- Add Trigger -->
            {{!-- <button class="add-trigger">➕ Add Trigger</button> --}}
        </div>

    </section>

</div>